# Copy to .env beside node.mjs; it is auto-loaded (without overriding variables
# already set in your environment).

# SDK client credentials (create in the dashboard -> SDK Access tab).
# The secret is only needed for configs and webhook mode; flag polling / SSE
# authenticate with the client id alone.
GOOSE_CLIENT_ID=
GOOSE_CLIENT_SECRET=

# What to read.
GOOSE_FLAGSET=checkout
GOOSE_NAMESPACE=production

# Optional config watcher: comma-separated config document names within the
# namespace (requires the client secret above).
GOOSE_CONFIGS=

# Optional webhook mode (requires the client secret above). When set, the flag
# stream switches from polling+SSE to polling+webhook and an embedded listener
# starts on :8091. Use host.docker.internal if the config service runs in
# Docker and this example runs on the host.
GOOSE_WEBHOOK_TARGET_URL=

# Optional: this app's own version ("2.4.0"). When set, config entries carrying
# min_app_version/max_app_version are gated against it — an out-of-range entry
# resolves to its "default" instead of its "value". Unset means every entry applies.
GOOSE_APP_VERSION=

# Optional override of the Goose service URL; leave it empty outside of
# development.
GOOSE_SERVER_URL=
