{
  "name": "@goose/sdk",
  "version": "0.2.0",
  "description": "JavaScript/TypeScript SDK for the Goose config service (browser flag reads + experiments; server-side configs + webhooks)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuildWithGooseDev/goose-js.git"
  },
  "homepage": "https://github.com/BuildWithGooseDev/goose-js#readme",
  "bugs": {
    "url": "https://github.com/BuildWithGooseDev/goose-js/issues"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepare": "npm run build"
  },
  "keywords": [
    "goose",
    "feature-flags",
    "experiments",
    "ab-testing",
    "sdk",
    "browser",
    "node",
    "configs",
    "webhooks"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
